# Newsletter Starter configuration. Copy to .env.local for local development.
# Never commit a populated environment file. All replace_me and example.com values are rejected.

# Operator authentication. Access denies by default unless both values and a valid allowlist are configured.
NEON_AUTH_BASE_URL=https://example.com
NEON_AUTH_COOKIE_SECRET=replace_me
OPERATOR_EMAIL_ALLOWLIST=operator@example.com

# Publication selection. A blank enabled list prevents scheduled drafting and webhook contact removal.
# NEWSLETTER_PUBLICATION is the optional default for manual/CLI drafting. The bundled sample is coaching.
NEWSLETTER_PUBLICATION=
NEWSLETTER_ENABLED_PUBLICATIONS=

# Explicit capability gates. Only the exact values true or 1 enable a capability.
NEWSLETTER_AUTOMATION_ENABLED=false
NEWSLETTER_DELIVERY_ENABLED=false
NEWSLETTER_IMAGE_GENERATION_ENABLED=false

# Scheduler authentication. Leave unset until the scheduler sends this as Authorization: Bearer <secret>.
CRON_SECRET=replace_me

# Resend email delivery. A complete configuration still cannot mutate Resend until delivery is enabled.
RESEND_API_KEY=replace_me
RESEND_AUDIENCE_ID=replace_me
RESEND_FROM_EMAIL=sender@example.com
RESEND_FROM_NAME=Newsletter
RESEND_REPLY_TO=reply@example.com
RESEND_WEBHOOK_SECRET=replace_me

# OpenAI-compatible LLM endpoint. Set the base URL, API key, and both model identifiers for your provider.
LLM_BASE_URL=https://example.com/v1
LLM_API_KEY=replace_me
NEWSLETTER_CURATOR_MODEL=replace_me
NEWSLETTER_WRITER_MODEL=replace_me
NEWSLETTER_WRITER_FALLBACK_MODELS=
# Optional legacy single-model fallback for both roles. Prefer the two role-specific variables above.
NEWSLETTER_MODEL=

# Optional X source service. Leave blank to use RSS sources only.
X_SOURCE_API_URL=

# Image generation. Configure every value below, then set NEWSLETTER_IMAGE_GENERATION_ENABLED=true.
# The bundled adapter uses a Gemini-compatible generateContent API. Replace with your provider's endpoint/model.
NANO_BANANA_API_KEY=replace_me
NANO_BANANA_BASE_URL=https://example.com/v1beta
NANO_BANANA_MODEL=replace_me
BLOB_READ_WRITE_TOKEN=replace_me

# Persistence. Required to store issues, drafts, settings, feedback, and suppression records.
POSTGRES_URL=replace_me

# Optional operational tuning. These values are safe defaults and do not enable external effects.
LOG_LEVEL=info
NEWSLETTER_SECTIONS_PER_ISSUE=4
NEWSLETTER_RSS_WINDOW_DAYS=7
NEWSLETTER_RSS_PER_FEED=10
NEWSLETTER_DEDUP_WINDOW_DAYS=14
NEWSLETTER_X_LIMIT=40
NEWSLETTER_ARCHIVE_BASE_URL=https://example.com
